* text=auto

*.cs       text diff=csharp
*.csproj   text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.slnx     text eol=crlf
*.ps1      text eol=crlf
*.sml      text
*.md       text
*.json     text
*.yml      text eol=lf

*.png      binary
*.snk      binary

# The conformance fixtures are compared byte for byte against what the writers produce, and the
# writers emit CRLF. Normalising them would make the comparison pass on Windows and fail on Linux,
# which is the least useful way for a test to behave.
assets/conformance/** -text