<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem.Recipes.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- xUnit1069 wants every test with a Timeout to name TestContext.Current.CancellationToken
         itself. Every test here passes RecipePair.Token, which IS that property - the indirection
         is the test support's and the analyser is syntactic, so it fires on all of them. The
         Timeout is deliberate and project-wide: on a fake clock a missing reply hangs rather than
         failing, a hung run prints no summary, and a run with no summary reads exactly like a
         negative control that found nothing. That has cost this repository four chapters. -->
    <NoWarn>$(NoWarn);xUnit1069</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stream 15 has no timer of its own, but the connection underneath it does - T3 above all -
         and a test that lets a wall clock drive those is a test that fails on a busy agent. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- The hosting test resolves the whole graph, which is how the claim that the host half
         declares no route at all gets asserted rather than left in a comment. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Recipes\Barbatos.SecsGem.Recipes.csproj" />
  </ItemGroup>

</Project>
