<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem.ProcessJobs.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- S16F11 carries a TIME, so this package has a clock in it - and a test that asserted
         sixteen characters against a wall clock would be a test that fails at midnight. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- The hosting test resolves the whole graph, which is the only way to prove that a router
         whose handlers depend on the connection it belongs to actually resolves. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.ProcessJobs\Barbatos.SecsGem.ProcessJobs.csproj" />
    <!-- The catalogue, for the one test that checks this package's vocabulary against the
         reference's own table. The fourth provenance measure found that the reference defines
         that table and names it from no message, so nothing but a test can make the two agree. -->
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Catalog\Barbatos.SecsGem.Catalog.csproj" />
    <!-- E40, E94, E90 and E87 are four standards in four packages, and a 300 mm tool implements
         all four. One test here registers every one of them and asserts that stream 14 answers
         for all six object types at once - a claim no single package can make, and the first real
         check that the composition those chapters added was not fixed for exactly three. -->
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Carriers\Barbatos.SecsGem.Carriers.csproj" />
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Substrates\Barbatos.SecsGem.Substrates.csproj" />
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.ControlJobs\Barbatos.SecsGem.ControlJobs.csproj" />
  </ItemGroup>

</Project>
