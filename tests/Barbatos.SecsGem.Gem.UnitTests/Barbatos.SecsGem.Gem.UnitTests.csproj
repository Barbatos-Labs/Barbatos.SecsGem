<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem.Gem.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every GEM timer - the establish-communications retry above all - is driven through
         TimeProvider, so a test advances a clock instead of sleeping on one. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- The hosting tests resolve the whole graph, which is the only way to prove that a router
         whose handlers depend on the connection it belongs to actually resolves. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Gem\Barbatos.SecsGem.Gem.csproj" />
    <!-- The catalogue, for the test that checks every acknowledgement enum here against the
         code table its item defines. Twelve of them were short of a member for the reserved
         range; nothing but this comparison would have found the thirteenth. -->
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Catalog\Barbatos.SecsGem.Catalog.csproj" />
  </ItemGroup>

</Project>
