<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem.ItemTransfer.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stream 21 has no timer of its own, but the connection underneath it does - T3 above all -
         and a test that lets a wall clock drive those is a test that fails on a busy agent. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- The hosting test resolves the whole graph, which is the only way to prove that the one
         registration both ends call resolves despite the cycle it has to break. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.ItemTransfer\Barbatos.SecsGem.ItemTransfer.csproj" />
  </ItemGroup>

</Project>
