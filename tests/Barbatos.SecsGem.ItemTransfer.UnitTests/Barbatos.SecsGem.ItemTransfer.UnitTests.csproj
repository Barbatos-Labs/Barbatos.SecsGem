<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem.ItemTransfer.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <!-- xUnit1069 wants every test with a Timeout to name TestContext.Current.CancellationToken
         itself, and cannot see that a helper property already is it. The Timeout is on the file
         store tests, where a control that breaks a store can leave a wire test waiting on a T3 the
         FakeTimeProvider never advances - a hung run prints no summary, and a run with no summary
         reads exactly like a control that found nothing. That has cost this repository five
         chapters. -->
    <NoWarn>$(NoWarn);xUnit1069</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Stream 21 has no timer of its own, but the connection underneath it does - T3 above all -
         and a test that lets a wall clock drive those is a test that fails on a busy agent. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- The hosting test resolves the whole graph, which is the only way to prove that the one
         registration both ends call resolves despite the cycle it has to break. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.ItemTransfer\Barbatos.SecsGem.ItemTransfer.csproj" />
    <!-- The catalogue, for the test that checks this package's code tables against the
         reference's own - the only way several packages serving one item can be made to agree. -->
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Catalog\Barbatos.SecsGem.Catalog.csproj" />
  </ItemGroup>

</Project>
