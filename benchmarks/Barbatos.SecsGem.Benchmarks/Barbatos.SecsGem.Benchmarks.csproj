<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(BarbatosSampleTargetFramework)</TargetFramework>
    <RootNamespace>Barbatos.SecsGem.Benchmarks</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- The format benchmarks build their registry through AddSecsSerialization() and friends,
         the same way an application does, so they need the container itself and not just its
         abstractions. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Core\Barbatos.SecsGem.Core.csproj" />
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Hsms\Barbatos.SecsGem.Hsms.csproj" />
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Serialization.Sml\Barbatos.SecsGem.Serialization.Sml.csproj" />
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Serialization.Json\Barbatos.SecsGem.Serialization.Json.csproj" />
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Serialization.Xml\Barbatos.SecsGem.Serialization.Xml.csproj" />
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Serialization.Ini\Barbatos.SecsGem.Serialization.Ini.csproj" />
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Mapper\Barbatos.SecsGem.Mapper.csproj" />

    <!-- The generator, referenced as an analyzer. MapperBenchmarks compares the contracts it emits
         against the ones reflection builds, and its setup refuses to run if the generated side is
         empty: two arms of reflection would report a dead heat and prove nothing. -->
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.SourceGenerators\Barbatos.SecsGem.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
