<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Barbatos.SecsGem.Objects</PackageId>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem.Objects</RootNamespace>
    <PackageTags>secs;e5;stream14;objectservices;getattr;setattr;attributes;namelist</PackageTags>
    <Description>Object services (SECS-II stream 14) for .NET: GetAttr and SetAttr for one object or many, and the three namelists that say which object types exist, which instances of a type exist and which attributes an object has. Either end may ask and either may answer, so one class does both. Stream 14 is a protocol over object models that other standards define - E87 carriers, E90 substrates, E94 control jobs - so this package supplies the protocol and your application supplies the objects, through one five-method interface. Depends on Barbatos.SecsGem.Hsms, not on GEM.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Core\Barbatos.SecsGem.Core.csproj" />
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Hsms\Barbatos.SecsGem.Hsms.csproj" />
  </ItemGroup>

</Project>
