<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Barbatos.SecsGem.Core</PackageId>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem</RootNamespace>
    <PackageTags>secs;secs-ii;ast;item;codec;transcoder;serialization;semi;e5</PackageTags>
    <Description>SECS-II object model for .NET: the SecsItem/SecsMessage abstract syntax tree, a zero-copy binary codec over ReadOnlySequence and IBufferWriter, and the Hub-and-Spoke serialization contracts (ISecsFormatReader / ISecsFormatWriter / SecsTranscoder). Contains no transport and no sockets, so it is safe to use in tooling, analyzers and WebAssembly.</Description>
  </PropertyGroup>

  <!-- No platform-specific API: usable from WebAssembly tooling. -->
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.HighPerformance" />
    <PackageReference Include="System.IO.Pipelines" />
    <!-- Abstractions only, never a container implementation: this package offers
         services.AddSecsSerialization() so a tool can resolve the transcoder through the same
         DI it configures everything else with, but it never builds or owns a container. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
