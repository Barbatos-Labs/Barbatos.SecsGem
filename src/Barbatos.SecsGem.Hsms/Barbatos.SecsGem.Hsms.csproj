<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Barbatos.SecsGem.Hsms</PackageId>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem.Hsms</RootNamespace>
    <PackageTags>hsms;hsms-ss;e37;state-machine;pipelines;channels;t3;t8;s9;transaction</PackageTags>
    <Description>HSMS-SS (SEMI E37) engine for .NET: an actor-driven connection state machine, a dual-path System.IO.Pipelines decoder with a correctly scoped T8 inter-character timeout, a transaction manager covering T3/T5/T6/T7/T8 over TimeProvider, automatic S9Fx error reporting, and first-class Microsoft.Extensions hosting and dependency injection.</Description>
    <!-- Lets the SDK's configuration-binding generator intercept Bind(), which is what keeps
         AddSecsGem(configuration) trim-safe and Native AOT friendly: without it, binding falls
         back to reflection over SecsGemOptions and the AOT analyzer rightly objects. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Core\Barbatos.SecsGem.Core.csproj" />
  </ItemGroup>

</Project>
