<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Barbatos.SecsGem.Mapper</PackageId>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem.Mapping</RootNamespace>
    <!-- The reflection resolver walks members the trimmer cannot see, so this package is
         honestly not AOT-safe yet. Phase 5 adds the generated resolver and flips this to true;
         until then, false keeps the claim truthful instead of suppressing the warnings that
         prove it. Core, Hsms and every format spoke remain AOT-compatible. -->
    <IsAotCompatible>false</IsAotCompatible>
    <PackageTags>mapper;serializer;poco;record;convention;reflection;sourcegenerator</PackageTags>
    <Description>Convention-over-configuration object mapper for SECS-II: maps C# classes and records to SecsItem trees in both directions using declaration order, with automatic C# to SecsFormat inference, nested lists, custom converters and the optional [SecsMessage] / [SecsItem] / [SecsIgnore] attributes.</Description>
  </PropertyGroup>

  <!-- No platform-specific API: usable from WebAssembly tooling. -->
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Core\Barbatos.SecsGem.Core.csproj" />
  </ItemGroup>

  <!-- The Roslyn component runs over this project at compile time; it is not a
       library dependency, so no assembly reference flows to consumers.
       TODO(Phase 5): also pack it into this package under analyzers/dotnet/cs. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.SourceGenerators\Barbatos.SecsGem.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

</Project>
