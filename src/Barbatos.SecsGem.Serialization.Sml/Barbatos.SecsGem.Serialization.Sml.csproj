<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Barbatos.SecsGem.Serialization.Sml</PackageId>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem.Serialization.Sml</RootNamespace>
    <PackageTags>sml;secs;text;reader;writer;spoke</PackageTags>
    <Description>SML (SECS Message Language) reader and writer for Barbatos.SecsGem - a Hub-and-Spoke format spoke that streams over PipeReader/PipeWriter and plugs into SecsTranscoder through AddSecsSml().</Description>
  </PropertyGroup>

  <!-- No platform-specific API: usable from WebAssembly tooling. -->
  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Core\Barbatos.SecsGem.Core.csproj" />
  </ItemGroup>

  <!-- Shared source rather than a package reference: AddSecsSml() and friends have to register
       the hub themselves, because the hub lives in Barbatos.SecsGem.Core and that package is not
       allowed a dependency on Microsoft.Extensions.DependencyInjection.Abstractions. -->
  <ItemGroup>
    <Compile Include="$(RepositoryDirectory)src\Shared\SecsSerializationRegistration.cs"
             Link="Shared\SecsSerializationRegistration.cs" />
  </ItemGroup>

</Project>
