<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Barbatos.SecsGem.Gem</PackageId>
    <TargetFrameworks>$(BarbatosTargetFrameworks)</TargetFrameworks>
    <RootNamespace>Barbatos.SecsGem.Gem</RootNamespace>
    <PackageTags>gem;e30;e5;ceid;svid;ecid;alid;collectionevent;alarm;controlstate</PackageTags>
    <Description>GEM (SEMI E30) for .NET, both ends: the communication and control state models as actors that cannot re-enter a transition, S1F13/S1F14 establish-communications with a retry delay on TimeProvider, host-configured report definitions and event links (S2F33/S2F35/S2F37), status and equipment constant namelists, alarms with listings, remote commands gated on the control state, opt-in process program management (stream 7's three capabilities: unformatted, formatted and the matrix) service program management, and spooling, all behind store interfaces and all with a durable implementation that keeps each record in a file and adopts the directory on the next start - the one thing deliberately not kept being the results of a service program run, which a restarted machine has not produced, terminal services for the operator standing at the machine, trace data collection on TimeProvider, limits monitoring with a deadband per band, identifiers read in whatever numeric format the host chose, and GemHost: the host side of every primary the equipment answers, with acknowledgement codes as enums rather than bytes.</Description>
    <!-- Lets the SDK's configuration-binding generator intercept Bind(), which is what keeps
         AddGemEquipment(configuration) trim-safe and Native AOT friendly: without it, binding
         falls back to reflection over GemOptions and the AOT analyzer rightly objects. -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referenced explicitly rather than leaning on the transitive reference through
         Barbatos.SecsGem.Hsms: this project uses all four directly. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Core\Barbatos.SecsGem.Core.csproj" />
    <ProjectReference Include="..\..\src\Barbatos.SecsGem.Hsms\Barbatos.SecsGem.Hsms.csproj" />
  </ItemGroup>

  <!-- Shared source rather than a package reference: the five stores here that outlive a process
       share a mechanism and not a rule, and the four transfer packages may not depend on this one
       any more than it depends on them - a machine serving recipes must not drag in GEM. -->
  <ItemGroup>
    <Compile Include="$(RepositoryDirectory)src\Shared\DurableRecordDirectory.cs"
             Link="Shared\DurableRecordDirectory.cs" />
  </ItemGroup>

</Project>
