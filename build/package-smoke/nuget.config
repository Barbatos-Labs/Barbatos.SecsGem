<?xml version="1.0" encoding="utf-8"?>
<!-- Two sources, mapped so that each one can only serve what it is supposed to.

     Barbatos.SecsGem.* comes from the local folder this repository just packed into, and nowhere
     else: if a package is missing from the feed, restore fails instead of quietly reaching
     nuget.org for a published version and testing that one. Everything else - the dependencies
     the packages declare - comes from nuget.org, which is how a consumer gets them. -->
<configuration>
  <packageSources>
    <clear />
    <add key="smoke-feed" value="../../artifacts/smoke-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="smoke-feed">
      <package pattern="Barbatos.SecsGem*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
